# Reportes — Phase 14: materialized DrawFinancial branch (FIN-REPORT-01..04).
#
# When true: getDailyReport + getAccountingReport read from the DrawFinancial /
# DrawFinancialProvider materialized aggregates (Phase 11) — eliminates the v1.2
# multi-draw attribution bug at the source.
#
# Default (unset or false) = legacy aggregation path. Preserves v1.2 behavior
# (including the multi-draw attribution bug) so the rollback path stays one-line
# auditable. Set to false + pm2 restart tote-backend resumes legacy immediately;
# no data migration needed.
#
# Set to true ONLY after ALL THREE gate conditions are met:
#   (a) Phase 11 backfill has been run and the reconciliation CSV shows zero
#       mismatches across the full DRAWN+prizesProcessed window.
#   (b) At least 2 weeks of live DrawFinancial rows have accumulated post the
#       Phase 11 production deploy (ROADMAP gate — gives real-world coverage
#       beyond the synthetic backfill).
#   (c) The 10-draw spot-check SQL (see
#       .planning/phases/14-report-refactor-weekly-pnl/14-DEPLOY.md) passes
#       — for a random sample of 10 recently-DRAWN draws, materialized
#       totalSales must equal the legacy live SUM(TicketDetail.amount).
#
# Pre-flip checklist (per 14-CONTEXT D-05): td.drawId backfill +
# prizesProcessed fix + DrawFinancial recon CSV mismatches=0 (executed by
# Plan 14-01 against the local mirror; production runs via 14-DEPLOY.md).
#
# Rollback: set to false and `pm2 restart tote-backend`. Legacy path resumes
# instantly. No data rollback needed — the materialized rows are unchanged.
REPORT_USE_MATERIALIZED=false
