# Database PostgreSQL Local
DATABASE_URL="postgresql://erp_user:erp_password_dev_2024@localhost:5433/tote_db?schema=public"

# Legacy MySQL Database (for migration from remote bot DB)
LEGACY_DB_HOST="144.126.150.120"
LEGACY_DB_PORT="3706"
LEGACY_DB_USER="diazhh"
LEGACY_DB_PASSWORD="Telecom2025*"
LEGACY_DB_NAME="bot"

# Server
PORT=10000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"

# Jobs
ENABLE_JOBS="true"

# pg-boss — Migración gradual de Croner a pg-boss
# Activar en orden de fase. Con false/ausente = comportamiento legacy (Croner).
# Rollback: cambiar a false + pm2 restart tote-backend
#
# Fase 1 — Validar infraestructura (riesgo: ninguno)
PGBOSS_SIMULATE_BETS=false
PGBOSS_TEST_BETS=false
# Fase 2 — APIs externas SRQ (riesgo: bajo)
PGBOSS_SYNC_API_PLANNING=false
PGBOSS_SYNC_API_TICKETS=false
# Fase 3 — Generación diaria de sorteos (riesgo: medio)
PGBOSS_GENERATE_DAILY_DRAWS=false
# Fase 4 — pg-boss native close-draw flow (re-arquitectura 2026-05-11).
#  PGBOSS_CLOSE_DRAW=true activa:
#    - close-and-ingest-sweep: cada minuto encola jobs para draws en [now+5, now+6)
#    - close-and-ingest:        cierra atómicamente y hace 2 pasadas SRQ por draw
#  Reemplaza el legacy close-draw.job.js (Croner) que fue eliminado.
PGBOSS_CLOSE_DRAW=false
#  PGBOSS_PRESELECT=true activa:
#    - preselect-sweep: cada minuto encola optimizer jobs para CLOSED sin preselect
#    - preselect:       corre selectPrewinner (optimizer) para un draw
#  Debe ir en pareja con PGBOSS_CLOSE_DRAW=true.
PGBOSS_PRESELECT=false
# Fase 5 — Pipeline completo de ejecución (riesgo: crítico, activar último)
PGBOSS_EXECUTE_DRAW=false
# Fase 6 — Imagenes especiales (piramides, resumenes, recomendaciones)
PGBOSS_SPECIAL_IMAGES=false

# Storage
STORAGE_PATH="./storage"
IMAGES_OUTPUT_PATH="./storage/output"

# SMTP Email
SMTP_HOST="mail.atilax.io"
SMTP_PORT=587
SMTP_USER="noreply@atilax.io"
SMTP_PASSWORD=""
SMTP_FROM="Multiloterias <noreply@atilax.io>"

